{
  "name": "cc-sessions-viewer",
  "private": true,
  "version": "0.6.3",
  "type": "module",
  "homepage": "https://sessions-viewer.js-bridge.com",
  "workspaces": [
    "site-docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "docs:dev": "npm run dev -w site-docs",
    "docs:build": "npm run docs:typecheck && npm run build -w site-docs",
    "docs:typecheck": "vue-tsc --noEmit -p site-docs/tsconfig.json",
    "docs:typecheck:tests": "vue-tsc --noEmit -p test/tsconfig.docs-usage-tools.json",
    "docs:test:ui": "npm run docs:typecheck:tests && vitest run test/DocsUsageTools.test.ts",
    "docs:preview": "npm run preview -w site-docs",
    "docs:test": "npm run test -w site-docs",
    "docs:test:adapters": "cargo test --manifest-path src-tauri/Cargo.toml --lib --locked --offline docs_public_fixture",
    "docs:indexnow": "npm run indexnow -w site-docs --",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "prepare": "husky",
    "release": "bumpp package.json src-tauri/tauri.conf.json src-tauri/Cargo.toml --commit \"release: v%s\" --tag \"v%s\" --push"
  },
  "changelogithub": {
    "types": {
      "feat": {
        "title": "🚀 Features"
      },
      "Feat": {
        "title": "🚀 Features"
      },
      "fix": {
        "title": "🐞 Bug Fixes"
      },
      "Fix": {
        "title": "🐞 Bug Fixes"
      },
      "perf": {
        "title": "🏎 Performance"
      },
      "refactor": {
        "title": "💅 Refactors"
      },
      "doc": {
        "title": "📖 Documentation"
      },
      "Doc": {
        "title": "📖 Documentation"
      },
      "Docs": {
        "title": "📖 Documentation"
      },
      "docs": {
        "title": "📖 Documentation"
      }
    },
    "contributors": true
  },
  "dependencies": {
    "@antv/g2": "^5.4.8",
    "@tanstack/vue-virtual": "^3.13.38",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "mermaid": "^11.17.2",
    "shiki": "^4.4.3",
    "vue": "^3.5.42",
    "vue-easy-lightbox": "^1.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@iconify-json/arcticons": "^1.2.57",
    "@iconify-json/lucide": "^1.2.132",
    "@iconify-json/material-icon-theme": "^1.2.70",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify-json/quill": "^1.2.4",
    "@iconify/utils": "^3.1.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
